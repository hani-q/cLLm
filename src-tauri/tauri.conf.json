{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cLLm",
  "version": "0.3.0",
  "identifier": "io.github.hani-q.cllm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cLLm",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/generated-player-portraits/**", "$APPDATA/package-assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "crates/ofm_core/data/default_names.json": "data/default_names.json",
      "crates/ofm_core/data/default_nations.json": "data/default_nations.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
